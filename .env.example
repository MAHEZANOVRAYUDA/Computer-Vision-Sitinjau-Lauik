# =====================================================================
# CONTOH FILE ENVIRONMENT VARIABLE
# =====================================================================
# Salin file ini menjadi ".env" (tanpa .example) dan isi dengan
# kredensial Anda yang sebenarnya. File ".env" TIDAK BOLEH di-commit
# ke Git / dibagikan ke publik karena berisi password.
#
# File config/config.yaml saat ini sudah cukup untuk prototipe lokal,
# jadi .env ini OPSIONAL - baru penting saat sistem sudah dipakai di
# jaringan nyata/produksi dengan kredensial yang harus dirahasiakan.
# =====================================================================

# Kredensial kamera RTSP (jika berbeda dari yang di config.yaml)
CAMERA_RTSP_USER=admin
CAMERA_RTSP_PASSWORD=

# Kredensial database
DB_PASSWORD=

# Kredensial MQTT (jika broker diberi autentikasi, tidak wajib untuk localhost)
MQTT_USERNAME=
MQTT_PASSWORD=
